# IntelliWare WIMS - Notification & SMTP Environment Configuration
# Copy this file to .env and adjust credentials to match your environment.

# Master Switches (1 = enabled, 0 = disabled)
NOTIF_SYSTEM_ENABLED=1
NOTIF_EMAIL_ENABLED=1
NOTIF_SMS_ENABLED=1

# Minimum Cooldown Period per Product (hours) to avoid spamming alerts on fluctuations
NOTIF_COOLDOWN_HOURS=24

# SMTP Configuration (PHPMailer)
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=alerts@intelliware.ph
SMTP_FROM_NAME="IntelliWare Inventory"

# Optional Global Extra Recipients (comma-separated, admin role users are notified by default)
NOTIF_EMAIL_RECIPIENTS=

# SMS Gateway (Optional: semaphore, twilio, sandbox)
SMS_PROVIDER=sandbox
SMS_API_KEY=
SMS_ACCOUNT_SID=
SMS_FROM_NUMBER=IntelliWare
