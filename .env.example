# IntelliWare WIMS Environment Configuration Template
# Copy this file to .env and customize values for your deployment server.

# -------------------------------------------------------------
# Application Environment
# -------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/IntelliWare

# -------------------------------------------------------------
# Database Configuration (MySQL / MariaDB)
# -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=warehouse_system
DB_USER=root
DB_PASSWORD=

# -------------------------------------------------------------
# Notifications & SMTP Email Configuration
# -------------------------------------------------------------
NOTIF_SYSTEM_ENABLED=1
NOTIF_EMAIL_ENABLED=1
NOTIF_COOLDOWN_HOURS=24
NOTIF_EMAIL_RECIPIENTS=

# SMTP Mail Server (e.g. Gmail App Password, SendGrid, Amazon SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=alerts@intelliware.ph
SMTP_FROM_NAME=IntelliWare Inventory

# -------------------------------------------------------------
# SMS Gateway (Optional: Semaphore, Twilio)
# -------------------------------------------------------------
NOTIF_SMS_ENABLED=0
SMS_PROVIDER=semaphore
SMS_API_KEY=
SMS_FROM_NUMBER=IntelliWare

# -------------------------------------------------------------
# Google Gemini AI & Multimodal Packaging Scanner
# -------------------------------------------------------------
# AI Vision and Philippine Seasonal Market Pulse Key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
AI_VISION_ENABLED=1
AI_VISION_MODEL=gemini-3.5-flash-lite

